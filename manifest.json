{
  "manifest_version": 3,
  "name": "CourseTracker AI",
  "version": "1.2.1",
  "description": "Automatically detects online course websites and adds a progress tracking checklist beside each lecture.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.udemy.com/*",
    "https://*.coursera.org/*",
    "https://*.youtube.com/*",
    "https://harkirat.classx.co.in/*",
    "https://*.100xdevs.com/*",
    "https://app.100xdevs.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/storage.js", "utils/progress.js", "utils/domScanner.js", "content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CourseTracker AI",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/content.css", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
